PORT=5001
NODE_ENV=production
FRONTEND_URL=https://your-app.vercel.app

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secrets (use long random strings — never use defaults in production)
JWT_ACCESS_SECRET=replace_with_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_string_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_VERIFY_EMAIL_EXPIRATION=24h
JWT_RESET_PASSWORD_EXPIRATION=1h

# Email Configuration (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="AI Learning Platform <noreply@ailearning.com>"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Evaluation Service (Gemini API)
GEMINI_API_KEY=your_gemini_api_key
