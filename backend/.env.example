PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/ai_coaching_platform

# JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_key_12345_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_67890_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_VERIFY_EMAIL_EXPIRATION=24h
JWT_RESET_PASSWORD_EXPIRATION=1h

# Email Configuration (Nodemailer / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
EMAIL_FROM="AI Learning Platform <noreply@ailearning.com>"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=mock_cloud
CLOUDINARY_API_KEY=mock_key
CLOUDINARY_API_SECRET=mock_secret

# AI Evaluation Service (Gemini API)
GEMINI_API_KEY=mock_gemini_api_key_replace_with_actual

# Redis Configuration (Optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
